# WHOOP OAuth 2.0 Credentials
# Create an app at https://developer-dashboard.whoop.com/
WHOOP_CLIENT_ID=your_client_id_here
WHOOP_CLIENT_SECRET=your_client_secret_here

# The redirect URI registered in the WHOOP developer portal
# It must match character-for-character, including port and trailing slash if any.
WHOOP_REDIRECT_URI=http://localhost:5001/callback

# Port for the local Flask backend server that hosts the dashboard
PORT=8000
